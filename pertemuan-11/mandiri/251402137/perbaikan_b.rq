
PREFIX ex: <http://contoh.id/>
PREFIX dbr: <http://dbpedia.org/resource/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>

CONSTRUCT {
  ?orang ex:nama ?nama .
}
WHERE {
  VALUES ?orang {
    dbr:Christopher_Nolan
    dbr:Joko_Anwar
    dbr:Mira_Lesmana
  }

  {
    ?orang foaf:name ?nama .
  }
  UNION
  {
    ?orang rdfs:label ?nama .
    FILTER NOT EXISTS {
      ?orang foaf:name ?prioritas
    }
  }
  UNION
  {
    ?orang schema:name ?nama .
    FILTER NOT EXISTS {
      ?orang foaf:name ?prioritas
    }
    FILTER NOT EXISTS {
      ?orang rdfs:label ?label
    }
  }
}
